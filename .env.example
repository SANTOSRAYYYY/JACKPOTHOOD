# 部署配置（复制为 .env 后填写，切勿提交真实私钥）
DEPLOYER_PRIVATE_KEY=0x...
# 回购多签钱包地址（建议 3/5 Safe，部署后唯一可提取购票 ETH）
BUYBACK_WALLET=0x...
# 真实 JACKPOTHOOD 代币地址（测试网可留空并置 DEPLOY_MOCK_JPH=true）
JPH_TOKEN=
DEPLOY_MOCK_JPH=false
# 单注票价（wei），默认 0.001 ETH = 1000000000000000
TICKET_PRICE_WEI=1000000000000000
# 部署后立即注入的保底奖池（JACKPOTHOOD 最小单位），默认 0
SEED_POOL_WEI=0
